{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "opencode",
  "version": "0.1.0",
  "identifier": "com.opencode.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:40081",
    "beforeDevCommand": "",
    "beforeBuildCommand": "bun run --cwd ../web build"
  },
  "bundle": {
    "icon": ["icons/icon.ico"]
  },
  "app": {
    "windows": [
      {
        "title": "opencode — AI 个人助手",
        "width": 900,
        "height": 620,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "center": true,
        "minWidth": 480,
        "minHeight": 380
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/opencode/**"]
      },
      "csp": null
    }
  }
}
