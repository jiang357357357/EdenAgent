{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "mcp": {
    "monmcp": {
      "type": "remote",
      "url": "http://127.0.0.1:40012/mcp",
      "discovery": {
        "type": "monhub",
        "serviceName": "MonMcp",
        "serviceType": "mcp_server",
        "capabilities": ["mcp", "mcp.streamable_http"],
        "udpPort": 40053,
        "timeout": 3000,
      },
      "enabled": true,
      "oauth": false,
      "timeout": 10000,
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
