{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "MonAgent",
  "version": "0.1.0",
  "identifier": "com.monagent.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:40091",
    "beforeDevCommand": "",
    "beforeBuildCommand": "bun run --cwd ../web build"
  },
  "bundle": {
    "icon": ["icons/icon.ico"]
  },
  "app": {
    "windows": [
      {
        "title": "MonAgent — AI 个人助手",
        "width": 900,
        "height": 620,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/mon-agent/**"]
      },
      "csp": null
    }
  }
}
