# ============================================================
# MonAgent .monconfig
# AI personal assistant development environment
# ============================================================

[service]
NAME=MonAgent
VERSION=0.1.0
PUBLIC_HOST=auto

[server]
HOST=0.0.0.0
PORT=40092
WEB_PORT=40091
BASE_URL=http://127.0.0.1:40092
WEB_URL=http://127.0.0.1:40091

[process]
NAME=MonAgent
PROCESS_TAG=monagent-main
SERVER_PM2_NAME=agent-api
WEB_PM2_NAME=agent-web
SCRIPT_AGENT_SERVER_LINUX_START=Script/Process/linux/server/start_process.sh
SCRIPT_AGENT_SERVER_LINUX_STOP=Script/Process/linux/server/stop_process.sh
SCRIPT_AGENT_SERVER_LINUX_STATUS=Script/Process/linux/server/status_process.sh
SCRIPT_AGENT_SERVER_LINUX_RESTART=Script/Process/linux/server/restart_process.sh
SCRIPT_AGENT_WEB_LINUX_START=Script/Process/linux/web/start_process.sh
SCRIPT_AGENT_WEB_LINUX_STOP=Script/Process/linux/web/stop_process.sh
SCRIPT_AGENT_WEB_LINUX_STATUS=Script/Process/linux/web/status_process.sh
SCRIPT_AGENT_WEB_LINUX_RESTART=Script/Process/linux/web/restart_process.sh
SCRIPT_CMD_LINUX_START=Script/Cmd/Linux/StartAll.sh
SCRIPT_CMD_SERVER_LINUX_START=Script/Cmd/Linux/StartServer.sh
SCRIPT_CMD_DESKTOP_LINUX_START=Script/Cmd/Linux/StartDesktop.sh
SCRIPT_CMD_WIN_START=Script/Cmd/Win/Start.ps1
SCRIPT_CMD_ALL_WIN_START=Script/Cmd/Win/StartAll.ps1
SCRIPT_CMD_SERVER_WIN_START=Script/Cmd/Win/StartServer.ps1
SCRIPT_CMD_DESKTOP_WIN_START=Script/Cmd/Win/StartDesktop.ps1
SCRIPT_AGENT_SERVER_ENV_LINUX_CHECK=Server/Script/EnvTools/linux/check_env.sh
SCRIPT_AGENT_SERVER_ENV_LINUX_INSTALL=Server/Script/EnvTools/linux/install_env.sh
SCRIPT_AGENT_SERVER_ENV_LINUX_REMOVE=Server/Script/EnvTools/linux/remove_env.sh
SCRIPT_AGENT_SERVER_ENV_WIN_CHECK=Server/Script/EnvTools/win/check_env.ps1
SCRIPT_AGENT_SERVER_ENV_WIN_INSTALL=Server/Script/EnvTools/win/install_env.ps1
SCRIPT_AGENT_SERVER_ENV_WIN_REMOVE=Server/Script/EnvTools/win/remove_env.ps1

[desktop]
TITLE=MonAgent — AI 个人助手
QUIT_FLAG=.artifacts/desktop-quit.flag

[log]
LEVEL=DEBUG
FILE=Data/Logs/Text/MonAgent/MonAgent.log
PLAIN_FILE=Data/Logs/Text/MonAgent/MonAgent_plain.log

[hub]
ENABLED=true
SERVICE_ID=monagent-001
SERVICE_NAME=MonAgent
SERVICE_TYPE=agent_service
DESCRIPTION=MonAgent 本地智能体服务
HUB_ZMQ_HOST=127.0.0.1
HUB_ZMQ_PORT=40051
HEARTBEAT_INTERVAL=30

[auth]
MODE=development

[auth_dev]
USERNAME=admin1
PASSWORD=123456

[self_awake]
STARTUP_WAKE_ENABLED=true
STARTUP_WAKE_DELAY_SECONDS=0
