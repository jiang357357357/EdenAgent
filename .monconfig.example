# Eden Agent local configuration example. Copy to .monconfig and customize locally.

[service]
NAME=Eden Agent
VERSION=1.8.0
PUBLIC_HOST=127.0.0.1

[server]
HOST=127.0.0.1
PORT=40092
WEB_PORT=40091
BASE_URL=http://127.0.0.1:40092
WEB_URL=http://127.0.0.1:40091

[process]
NAME=Eden Agent
PROCESS_TAG=edenagent-main
SERVER_PM2_NAME=agent-api
SCRIPT_AGENT_SERVER_LINUX_START=Script/Process/linux/server/start_process.sh
SCRIPT_AGENT_SERVER_LINUX_STOP=Script/Process/linux/server/stop_process.sh
SCRIPT_AGENT_SERVER_LINUX_STATUS=Script/Process/linux/server/status_process.sh
SCRIPT_AGENT_SERVER_LINUX_RESTART=Script/Process/linux/server/restart_process.sh
SCRIPT_AGENT_SERVER_WIN_START=Script/Cmd/Win/StartServer.ps1
SCRIPT_CMD_LINUX_START=Script/Cmd/Linux/StartAll.sh
SCRIPT_CMD_SERVER_LINUX_START=Script/Cmd/Linux/StartServer.sh
SCRIPT_CMD_DESKTOP_LINUX_START=Script/Cmd/Linux/StartDesktop.sh
SCRIPT_CMD_WIN_START=Script/Cmd/Win/Start.ps1
SCRIPT_CMD_ALL_WIN_START=Script/Cmd/Win/StartAll.ps1
SCRIPT_CMD_SERVER_WIN_START=Script/Cmd/Win/StartServer.ps1
SCRIPT_CMD_DESKTOP_WIN_START=Script/Cmd/Win/StartDesktop.ps1
SCRIPT_VENV_LINUX_CHECK=Server/Script/EnvTools/linux/check_env.sh
SCRIPT_VENV_LINUX_INSTALL=Server/Script/EnvTools/linux/install_env.sh
SCRIPT_VENV_LINUX_REMOVE=Server/Script/EnvTools/linux/remove_env.sh
SCRIPT_VENV_WIN_CHECK=Server/Script/EnvTools/win/check_env.ps1
SCRIPT_VENV_WIN_INSTALL=Server/Script/EnvTools/win/install_env.ps1
SCRIPT_VENV_WIN_REMOVE=Server/Script/EnvTools/win/remove_env.ps1
SCRIPT_AGENT_SERVER_ENV_LINUX_CHECK=Server/Script/EnvTools/linux/check_env.sh
SCRIPT_AGENT_SERVER_ENV_LINUX_INSTALL=Server/Script/EnvTools/linux/install_env.sh
SCRIPT_AGENT_SERVER_ENV_LINUX_REMOVE=Server/Script/EnvTools/linux/remove_env.sh
SCRIPT_AGENT_SERVER_ENV_WIN_CHECK=Server/Script/EnvTools/win/check_env.ps1
SCRIPT_AGENT_SERVER_ENV_WIN_INSTALL=Server/Script/EnvTools/win/install_env.ps1
SCRIPT_AGENT_SERVER_ENV_WIN_REMOVE=Server/Script/EnvTools/win/remove_env.ps1

[desktop]
TITLE=Eden Agent — AI 个人助手
QUIT_FLAG=.artifacts/desktop-quit.flag

[log]
LEVEL=DEBUG
FILE=Data/Logs/Text/Eden Agent/Eden Agent.log
PLAIN_FILE=Data/Logs/Text/Eden Agent/Eden Agent_plain.log
DISPLAY_ENABLED=true
RENDER_DIR=Data/Logs/Render
RENDER_FILE=Data/Logs/Render/render.log
RENDER_PLAIN_FILE=Data/Logs/Render/render_plain.log
RENDER_PANELS=Data/Logs/Render/panels.json
CONSOLE_ENABLED=true
FILE_ENABLED=true
COLOR_ENABLED=true
DUAL_FILE_ENABLED=true
MAX_BYTES=10485760
BACKUP_COUNT=5

[auth]
MODE=development

[auth_dev]
USERNAME=
PASSWORD=

[environment]
TIMEZONE=Asia/Shanghai
LOCALE=zh-CN
COUNTRY=
REGION=
CITY=
LATITUDE=
LONGITUDE=

[search]
PROVIDER=parallel_mcp,exa_mcp,bing,duckduckgo
TIMEOUT_MS=10000
CACHE_TTL_SECONDS=120
FETCH_TIMEOUT_MS=20000
FETCH_MAX_BYTES=2097152

[self_awake]
STARTUP_WAKE_ENABLED=true
STARTUP_WAKE_DELAY_SECONDS=0
