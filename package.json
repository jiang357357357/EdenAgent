{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "eden-agent",
  "description": "Eden Agent local-first TypeScript host with pi",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "check:architecture": "node Script/Architecture/check.mjs",
    "test:architecture": "node --test Script/Architecture/rules.test.mjs",
    "legacy:export": "node --import tsx Script/Project/export_legacy.mjs",
    "legacy:import": "node --import tsx Script/Project/import_legacy.mjs",
    "inventory:runtime": "node Script/Project/inventory-runtime.mjs",
    "build:server": "node Script/Project/build_server.mjs",
    "start:server": "node dist/server/main.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test:server": "tsx --test packages/*/tests/*.test.ts Server/tests/*.test.ts",
    "dev": "node Script/Project/dev.mjs",
    "dev:server": "node Script/Project/start_server.mjs",
    "dev:web": "npm --prefix frontend/web run dev",
    "dev:desktop": "node Script/Project/dev_desktop.mjs",
    "generate:rpc": "node Script/Project/generate_rpc.mjs",
    "build:connector:hoi4": "cargo build -p eden-agent-connector-hoi4",
    "package:connector:hoi4": "node Script/Project/package_connector.mjs hoi4 --profile debug",
    "build:connector:lichess": "cargo build -p eden-agent-connector-lichess",
    "package:connector:lichess": "node Script/Project/package_connector.mjs lichess --profile debug",
    "build:connector:openttd": "cargo build -p eden-agent-connector-openttd",
    "package:connector:openttd": "node Script/Project/package_connector.mjs openttd --profile debug",
    "build:connector:victoria3": "cargo build -p eden-agent-connector-victoria3",
    "package:connector:victoria3": "node Script/Project/package_connector.mjs victoria3 --profile debug",
    "build:connectors": "cargo build -p eden-agent-connector-hoi4 -p eden-agent-connector-lichess -p eden-agent-connector-openttd -p eden-agent-connector-victoria3",
    "package:connectors": "npm run package:connector:hoi4 && npm run package:connector:lichess && npm run package:connector:openttd && npm run package:connector:victoria3",
    "test:command-live": "cargo build -p eden-agent-server --locked && node --experimental-strip-types Script/Project/test_command_runtime_live.mjs",
    "test:dev-smoke": "npm --prefix frontend run test:dev-smoke",
    "test:process-runner": "npm --prefix frontend run test:process-runner",
    "test:openttd-launcher": "node --test Script/Project/openttd_launcher.test.mjs",
    "lint": "oxlint",
    "typecheck": "npm run typecheck:server && npm --prefix frontend/web run typecheck",
    "postinstall": "node -e \"console.log('Eden Agent uses isolated TypeScript hosts with pi for Eden and Local.')\"",
    "prepare": "husky",
    "test": "npm run test:architecture && npm run test:server"
  },
  "workspaces": [
    "frontend/*",
    "Server",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.28.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "prettier": "3.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jiang357357357/EdenAgent.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
