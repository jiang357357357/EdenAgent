{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "eden-agent",
  "description": "Eden Agent local-first TypeScript host with pi",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "setup:video": "node Script/Project/setup_video_context.mjs",
    "check:architecture": "node Script/Architecture/check.mjs",
    "test:architecture": "node --test Script/Architecture/rules.test.mjs Script/Test/discover_tests.test.mjs",
    "inventory:runtime": "node Script/Project/inventory-runtime.mjs",
    "build:server": "node Script/Project/build_server.mjs",
    "start:server": "node dist/server/main.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test:server": "node Script/Test/run_typescript_tests.mjs packages Server/tests",
    "dev": "node Script/Project/dev.mjs",
    "dev:server": "node Script/Project/start_server.mjs",
    "dev:web": "npm --prefix frontend/web run dev",
    "dev:desktop": "node Script/Project/dev_desktop.mjs",
    "generate:rpc": "node Script/Project/generate_rpc.mjs",
    "test:command-live": "node --import tsx --test Server/tests/workspace-tools.test.ts packages/execution/tests/external-process.test.ts",
    "test:dev-smoke": "npm --prefix frontend run test:dev-smoke",
    "test:process-runner": "npm --prefix frontend run test:process-runner",
    "lint": "oxlint",
    "typecheck": "npm run typecheck:server && npm --prefix frontend/web run typecheck",
    "postinstall": "node -e \"console.log('Eden Agent uses isolated TypeScript hosts with pi for Eden and Local.')\"",
    "prepare": "husky",
    "test": "npm run test:architecture && npm run test:server",
    "test:server-artifact": "npm run build:server && node --import tsx --test --test-concurrency=2 Script/Project/server_artifact.test.mjs Script/Project/process_artifact.test.mjs Script/Project/dialogue_latency_artifact.test.mjs",
    "test:workspace-artifact": "npm run build:server && node --test Script/Project/workspace_artifact.test.mjs",
    "test:logging-artifact": "npm run build:server && node --test Script/Project/logging_artifact.test.mjs",
    "test:project": "node --test Script/Project/runtime_children.test.mjs Script/Project/desktop_broker_environment.test.mjs Script/Project/development-realm.test.mjs Script/Project/development-launcher.test.mjs Script/Project/connector_resources.test.mjs Script/Project/local_runtime_environment.test.cjs Script/Project/server_dependency_plan.test.mjs Script/Project/monconfig.test.mjs frontend/tests/process-runner.test.mjs",
    "test:maintenance": "node --import tsx --test --test-concurrency=2 Script/Project/wsl_service.test.mjs Script/Project/sanitize_memory_credentials.test.mjs Script/Project/consolidate_self_awake.test.mjs",
    "test:all": "npm test && npm --prefix frontend/web test && npm --prefix frontend/desktop test && npm --prefix frontend run test:package && npm run test:project && npm run test:server-artifact",
    "build:connector": "node Script/Project/package_connector.mjs",
    "create:extension": "node Script/Project/create_extension.mjs"
  },
  "workspaces": [
    "frontend/*",
    "Server",
    "packages/*"
  ],
  "devDependencies": {
    "@electron/packager": "20.0.1",
    "@types/node": "22.19.19",
    "@types/ssh2": "1.15.6",
    "esbuild": "0.28.1",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "prettier": "3.6.2",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jiang357357357/EdenAgent.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
